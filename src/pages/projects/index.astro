---
import { Button, Icon } from 'astro-pure/user'
import PageLayout from '@/layouts/CommonPage.astro'
import ProjectSection from '@/components/projects/ProjectSection.astro'

const headings = [
  { depth: 2, slug: 'programs', text: 'Programs' },
  { depth: 2, slug: 'learnings', text: 'Learnings' },
  { depth: 2, slug: 'others', text: 'Others' }
]
---

<PageLayout title='Projects' {headings} view>
  {/* TODO: 在这里介绍你的项目 */}
  <p>这里列出我做过的一些项目。</p>
  <Button title='Get in touch' class='w-fit' href='/connect'>
    <Icon class='size-5' name='receive-money' slot='before' />
  </Button>

  <h2 id='programs'>Programs</h2>
  {/* TODO: 替换为你自己的项目；links type 支持 github / site / doc / release 等 */}
  <ProjectSection
    projects={[
      {
        name: '🚧 项目占位',
        description: '在 src/pages/projects/index.astro 里填写你的项目',
        links: []
      }
    ]}
  />

  <h2 id='learnings'>Learnings</h2>
  <ProjectSection class='my-2' projects={[]} />

  <h2 id='others'>Others</h2>
  <ProjectSection projects={[]} />
</PageLayout>
