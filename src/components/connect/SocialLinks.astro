---
import { type iconsType } from 'astro-pure/types'
import SocialRow from './SocialRow.astro'

interface SocialItem {
  platform: string
  handle?: string
  /** Omit for handles without a public profile URL — the row becomes click-to-copy. */
  link?: string
  icon: iconsType | 'xiaohongshu' | 'qq'
  color?: string
}

/** An entry is either a single row, or a stack of rows for the same platform
 *  (collapsed by default, expands on hover / keyboard focus). */
type Entry = SocialItem | { stack: SocialItem[] }

const { links } = Astro.props as { links: Entry[] }
---

<div class='not-prose flex flex-col gap-2 rounded-xl border p-2 sm:p-3'>
  {
    links.map((entry) =>
      'stack' in entry ? (
        <div class='social-stack relative flex flex-col'>
          {entry.stack.map((item) => (
            <SocialRow {...item} />
          ))}
        </div>
      ) : (
        <SocialRow {...entry} />
      )
    )
  }
</div>

<style is:global>
  .social-stack > * {
    position: relative;
    transition:
      margin-top 0.28s ease,
      transform 0.28s ease,
      opacity 0.28s ease;
  }
  /* Topmost card stays put and covers the ones behind it */
  .social-stack > :first-child {
    z-index: 2;
  }
  /* Trailing cards slide up behind the first one, peeking out at the bottom */
  .social-stack > :not(:first-child) {
    z-index: 1;
    margin-top: -2rem;
    transform: scale(0.965);
    opacity: 0.85;
  }
  /* Fan out on hover or when a child receives keyboard focus */
  .social-stack:hover > :not(:first-child),
  .social-stack:focus-within > :not(:first-child) {
    margin-top: 0.5rem;
    transform: none;
    opacity: 1;
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-copy]').forEach((el) => {
    el.addEventListener('click', async () => {
      const text = el.dataset.copy ?? ''
      try {
        await navigator.clipboard.writeText(text)
      } catch {
        return
      }
      const tip = el.querySelector('[data-copy-tip]')
      if (tip) {
        const prev = tip.textContent
        tip.textContent = '已复制 ✓'
        setTimeout(() => {
          tip.textContent = prev
        }, 1500)
      }
    })
  })
</script>
